<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Mac2WinReceiver.Core</RootNamespace>
    <AssemblyName>Mac2WinReceiver.Core</AssemblyName>
    <Description>UI-free protocol and transfer core for the Mac2Win Transfer Windows receiver (ADR-002: cross-platform net10.0).</Description>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel/ASP.NET for the receiver's HTTPS endpoint; still cross-platform net10.0 (ADR-002) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

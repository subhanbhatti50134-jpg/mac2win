<Window x:Class="Mac2WinReceiver.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mac2WinReceiver.App.Views"
        mc:Ignorable="d"
        Title="Mac2Win Transfer — Receiver"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mac2WinReceiver.App;component/Themes/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="🖥️" FontSize="24" Margin="0,0,12,0" />
            <TextBlock Text="Mac2Win Transfer" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">

                <!-- Receive status card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Receive Status" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <CheckBox Content="Ready to receive"
                                  IsChecked="{Binding IsReady, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,12" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" FontSize="13"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="PIN: " FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Pin}" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,16,0" />
                            <TextBlock Text="Port: 48600" FontSize="13" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connection code + QR card -->
                <Border Style="{StaticResource CardPanel}" Visibility="{Binding HasConnectionCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Connect from Mac" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Scan the QR or type the code on the Mac:" FontSize="13"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding ConnectionCode, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" TextWrapping="NoWrap" Margin="0,0,0,10"
                                 HorizontalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding QrImageBase64, Converter={StaticResource Base64ToImageConverter}}"
                                   Width="180" Height="180" Margin="0,0,20,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Connection code (m2w://)" FontSize="13" Margin="0,0,0,6" />
                                <Button Content="Copy code"
                                        Command="{Binding CopyCodeCommand}"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Transfers" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="— no active transfers" FontSize="13"
                                       Foreground="{StaticResource TextMuted}"
                                       Visibility="{Binding Sessions.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                                    <TextBlock Text=" • " Foreground="{StaticResource TextMuted}" />
                                                    <TextBlock Text="{Binding RemoteIp}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Percent, StringFormat=\{0:F0\}%}" FontWeight="Bold" />
                                                <ProgressBar Value="{Binding Percent}" Width="120" Height="6" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- History card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="History" FontWeight="SemiBold" FontSize="14" />
                            <Button Content="Clear" FontSize="12" Margin="12,0,0,0"
                                    Command="{Binding ClearHistoryCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding History}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,4" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalBytes}" FontSize="12" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Actions card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Actions" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Choose destination folder" Margin="0,0,12,0"
                                    Command="{Binding PickDestinationCommand}" />
                            <Button Content="Open destination folder"
                                    Command="{Binding OpenDestinationCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Conflict policy:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding ConflictPolicies}"
                                      SelectedItem="{Binding ConflictPolicy}" Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Export report (JSON)" Margin="0,0,8,0"
                                    Command="{Binding ExportJsonCommand}" />
                            <Button Content="Export report (CSV)" Margin="0,0,8,0"
                                    Command="{Binding ExportCsvCommand}" />
                            <Button Content="Export report (HTML)"
                                    Command="{Binding ExportHtmlCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Revoke device"
                                    Command="{Binding RevokeDeviceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarningBrush}"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

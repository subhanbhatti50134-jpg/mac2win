<Application x:Class="Mac2WinReceiver.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: App.OnStartup creates MainWindow only after the server, certificate and
         view-model are wired. A StartupUri here produces a second, unbound window (observed
         2026-11-19: two top-level windows, both titled "Mac2Win Transfer - Receiver"). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mac2win.local/schema/session-create.schema.json",
  "title": "SessionCreateRequest",
  "type": "object",
  "required": ["summary", "sourceDevice"],
  "additionalProperties": true,
  "properties": {
    "summary": {
      "type": "object",
      "required": ["fileCount", "dirCount", "totalBytes"],
      "additionalProperties": true,
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "dirCount": { "type": "integer", "minimum": 0 },
        "symlinkCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "sourceDevice": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 } }
    }
  }
}

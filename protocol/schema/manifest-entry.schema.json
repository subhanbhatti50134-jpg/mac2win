{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mac2win.local/schema/manifest-entry.schema.json",
  "title": "ManifestEntry",
  "description": "One enumerated item. Paths are relative, NFC, '/'-separated, no leading '/', no '.' or '..' segments.",
  "type": "object",
  "required": ["path", "type", "size", "mtimeUtcNs", "mode"],
  "additionalProperties": true,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).*$",
      "description": "Relative path, Unicode NFC, '/' separators."
    },
    "type": { "enum": ["file", "dir", "symlink"] },
    "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "mtimeUtcNs": { "type": "string", "pattern": "^[0-9]{1,19}$", "description": "UTC ns since epoch as decimal string." },
    "ctimeUtcNs": { "type": "string", "pattern": "^[0-9]{1,19}$" },
    "mode": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "POSIX mode, informational." },
    "symlinkTarget": { "type": "string", "description": "Required iff type == symlink." }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "symlink" } } }, "then": { "required": ["symlinkTarget"] } }
  ]
}
